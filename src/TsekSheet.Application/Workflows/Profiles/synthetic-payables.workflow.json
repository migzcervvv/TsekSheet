  "aliases": [ { "alias": "Acme Trading", "canonical": "Acme Trading Incorporated" } ],
  "foldCase": true,
  "collapseWhitespace": true,
  "fallbackSectionId": "external",
  "existingDestination": "after-last-match",
  "missingDestination": "before-subtotal",
  "duplicatePolicy": "entity-and-any-identifier",
