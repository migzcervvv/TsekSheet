    { "key": "rfp", "header": "RFP number", "kind": "text", "required": false, "maxLength": 64 },
    { "key": "invoice", "header": "Invoice number", "kind": "text", "required": false, "maxLength": 64 },
    { "key": "amount", "header": "Amount", "kind": "decimal", "required": true, "maxLength": 32 },
    { "key": "date", "header": "Record date", "kind": "date", "required": false, "maxLength": 10 }
  ],
  "sections": [
    { "id": "internal", "label": "Synthetic internal payables", "heading": "2025 PAYABLES (INTERNAL)", "subtotal": "INTERNAL SUBTOTAL" },
    { "id": "external", "label": "Synthetic external payables", "heading": "2025 PAYABLES (EXTERNAL)", "subtotal": "EXTERNAL SUBTOTAL" }
