    <Compile Include="../../src/TsekSheet.Excel/SnapshotIdentity.cs" Link="Shared/SnapshotIdentity.cs" />
    <Compile Include="../../src/TsekSheet.Excel/ExcelReadback.cs" Link="Shared/ExcelReadback.cs" />
    <Compile Include="../../src/TsekSheet.Excel/StaCommandQueue.cs" Link="Shared/StaCommandQueue.cs" />
