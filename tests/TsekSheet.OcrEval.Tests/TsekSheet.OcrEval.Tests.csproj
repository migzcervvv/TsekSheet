<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/OcrEval/OcrEval.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
  <Target Name="CopyOcrWorkers" AfterTargets="Build">
    <ItemGroup>
      <OcrWorker Include="../../tools/OcrEval/bin/$(Configuration)/net10.0-windows/OcrEval.*" />
      <OcrRenderer Include="../../tools/OcrEval/bin/$(Configuration)/net10.0-windows/renderer/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(OcrWorker)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OcrRenderer)" DestinationFiles="@(OcrRenderer->'$(OutDir)renderer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
