<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Fixtures\LiquidationProfile.cs" Link="Fixtures\LiquidationProfile.cs" />
    <Compile Include="..\Fixtures\LiquidationFixture.cs" Link="Fixtures\LiquidationFixture.cs" />
    <Compile Include="..\Fixtures\PayablesFixture.cs" Link="Fixtures\PayablesFixture.cs" />
    <Compile Include="..\Fixtures\InspectionFixture.cs" Link="Fixtures\InspectionFixture.cs" />
    <Compile Include="..\Fixtures\AccountingCompatibilityFixture.cs" Link="Fixtures\AccountingCompatibilityFixture.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <ProjectReference Include="..\..\src\TsekSheet.Desktop\TsekSheet.Desktop.csproj" />
    <Content Include="..\..\experiments\archive\WorkbookLibrary.Evaluation\Fixtures\*.xlsx" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySmokeAssets" AfterTargets="Build">
    <ItemGroup><OcrWorker Include="../../tools/OcrEval/bin/$(Configuration)/net10.0-windows/OcrEval.*" /></ItemGroup>
    <Copy SourceFiles="@(OcrWorker)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup><SmokeAsset Include="..\..\src\TsekSheet.Frontend\dist\**\*" /></ItemGroup>
    <Copy SourceFiles="@(SmokeAsset)" DestinationFiles="@(SmokeAsset->'$(TargetDir)frontend\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup><RenderAsset Include="..\..\src\TsekSheet.Desktop\bin\$(Configuration)\net10.0-windows\renderer\**\*" /></ItemGroup>
    <Copy SourceFiles="@(RenderAsset)" DestinationFiles="@(RenderAsset->'$(TargetDir)renderer\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Import Project="..\..\src\TsekSheet.Excel\InteropReferences.props" />
</Project>
